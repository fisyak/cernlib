+            POWER=LOG(SENA(KE,JA+1)/SLOW)/TEMP2
+         ELSE
+            SLOW=SEPA(KE,JA)
+            POWER=LOG(SEPA(KE,JA+1)/SLOW)/TEMP2
+         ENDIF
+         TSIG(I)=SLOW*TEMP1**POWER
+      KE=KE+1
