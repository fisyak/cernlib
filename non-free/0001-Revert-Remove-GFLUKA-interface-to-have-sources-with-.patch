+*-- Author :
+*$ CREATE FEKFNC.FOR
+*COPY FEKFNC
+*
+*=== fekfnc ===========================================================*
+*
+      FUNCTION FEKFNC (PF,I)
+ 
+#include "geant321/dblprc.inc"
+#include "geant321/dimpar.inc"
+#include "geant321/iounit.inc"
+*
+#include "geant321/nucgeo.inc"
