+      DO 10 J=1,39
+         BTYPE(J)=BTYPE1(J)
+         IJDISC(J)=IJDIS1(J)
+         LHADRO(J)=LHADR1(J)
+  10  CONTINUE
+      DO 20 J=1,30
+         GENPAR(J)=GENPA1(J)
+   20 CONTINUE
+      DO 30 J=1,10
+         ISCORE(J)=ISCOR1(J)
+   30 CONTINUE
+      LPRBSD = LPRBD1
+      LPRBSI = LPRBI1
+*=                                               end*block.blkdt1      *
+      END
