+C
+        IF(KPROJ.EQ.8) GOTO 101
+        IF(KPROJ.EQ.1) GOTO 102
+C*                                INVALID REACTION
+        RETURN
+C-------------------------------- NP ELASTIC SCATTERING----------
+101   CONTINUE
+      IF (EKIN.GT.0.740D+0)GOTO 1000
