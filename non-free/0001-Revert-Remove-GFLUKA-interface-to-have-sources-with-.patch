+         ELSEIF(EKIN.GT.10.D0) THEN
+            IPOL=1
+            PO2=20.D0
+            EK2=SQRT(PO2**2+AM(KPROJ)**2) - AM(KPROJ)
+            SEL2=RELTO(KPROJ)*SHPTOT(KPROJ,PO2)
+            EK1=10.D0
+         ENDIF
+C
+         DO 101 IE=1,NEN
